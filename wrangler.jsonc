// Déploiement Cloudflare Workers : site statique (dist/) + authentification de Decap (worker/).
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "hbcizon",
  "main": "worker/index.ts",
  "compatibility_date": "2026-09-26",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "html_handling": "auto-trailing-slash",
    // Seules les routes /api/* passent par le Worker ; le reste est servi directement.
    "run_worker_first": ["/api/*"],
  },
  "observability": { "enabled": true },
  // OAuth App GitHub « Site HBC Izon — administration » (compte izonhandball).
  // L'identifiant est public ; le secret GITHUB_CLIENT_SECRET est posé sur le Worker
  // depuis le tableau de bord Cloudflare (Settings → Variables and Secrets), jamais ici.
  "vars": { "GITHUB_CLIENT_ID": "Ov23liwK3aU0M7hWOwFp" },
}
