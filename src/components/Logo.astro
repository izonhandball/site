---
import { imagePublique } from "../lib/site";

// Logo du club : public/logo.webp (256 px, tiré de la photo de profil Facebook du club en 960 px).
// Si le fichier manque, on affiche une pastille jaune « HBC IZON ».
interface Props {
  taille: number;
}
const { taille } = Astro.props;
const src = imagePublique("/logo.webp");
---

{src ? (
  <img class="logo" src={src} alt="Logo du HBC Izon" width={taille} height={taille} />
) : (
  <span
    class="logo logo--provisoire"
    style={`width:${taille}px;height:${taille}px`}
    role="img"
    aria-label="Logo du HBC Izon"
  >
    HBC
    <br />
    IZON
  </span>
)}
