---
// Pictogrammes en trait, repris de la maquette.
interface Props {
  nom: "instagram" | "precedent" | "suivant" | "fermer" | "lieu" | "mail";
  taille?: number;
}
const { nom, taille = 18 } = Astro.props;
---

<svg
  width={taille}
  height={taille}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width={nom === "precedent" || nom === "suivant" || nom === "fermer" ? 2.5 : 2}
  aria-hidden="true"
>
  {nom === "instagram" && (
    <>
      <rect x="3" y="3" width="18" height="18" rx="5" />
      <circle cx="12" cy="12" r="4" />
      <circle cx="17.5" cy="6.5" r="1" fill="currentColor" stroke="none" />
    </>
  )}
  {nom === "precedent" && <path d="M15 5l-7 7 7 7" />}
  {nom === "suivant" && <path d="M9 5l7 7-7 7" />}
  {nom === "fermer" && <path d="M6 6l12 12M18 6L6 18" />}
  {nom === "lieu" && (
    <>
      <path d="M12 21s-7-6.2-7-11.5a7 7 0 0 1 14 0C19 14.8 12 21 12 21z" />
      <circle cx="12" cy="9.5" r="2.5" />
    </>
  )}
  {nom === "mail" && (
    <>
      <rect x="3" y="5" width="18" height="14" rx="2" />
      <path d="M3 7l9 6 9-6" />
    </>
  )}
</svg>
