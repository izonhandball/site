---
import { ICONES, epaisseurIcone, type NomIcone } from "../lib/icones";

interface Props {
  nom: NomIcone;
  taille?: number;
}
const { nom, taille = 18 } = Astro.props;
---

<svg
  width={taille}
  height={taille}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width={epaisseurIcone(nom)}
  aria-hidden="true"
  set:html={ICONES[nom]}
/>
