---
import Icone from "./Icone.astro";
import FormulaireContact from "./FormulaireContact.astro";
import { getClub } from "../lib/site";

// Fenêtre ouverte par les boutons « Nous contacter » de l'en-tête et du pied de page.
const club = await getClub();
---

<dialog id="fenetre-contact" class="fenetre contact" aria-labelledby="contact-titre">
  <div class="contact__corps">
    <button type="button" class="btn-carre contact__fermer" data-fermer aria-label="Fermer">
      <Icone nom="fermer" />
    </button>
    <div class="contact__affiche">
      <h2 id="contact-titre" class="contact__titre">
        Nous contacter
      </h2>
      <p class="script contact__accroche">Une question, un essai, un partenariat ?</p>
    </div>

    <div class="contact__zone">
      <FormulaireContact id="contact" />
    </div>

    <!-- Après le formulaire sur mobile ; en bas de la colonne jaune sur grand écran. -->
    <div class="contact__coordonnees">
      <ul class="contact__infos">
        <li>
          <Icone nom="lieu" taille={18} />
          <span>
            {club.salle.nom}
            <br />
            {club.salle.adresse}
          </span>
        </li>
        <li>
          <Icone nom="mail" taille={18} />
          <a href={`mailto:${club.email}`}>{club.email}</a>
        </li>
      </ul>
      <p class="contact__adhesion">
        Déjà décidé ? L'inscription se fait en ligne sur
        <a href={club.liens.gesthand}>Gesthand</a>, le site de la FFHandball.
      </p>
    </div>
  </div>
</dialog>

<style>
  .contact {
    width: min(1040px, 100vw);
  }
  .contact__corps {
    position: relative;
    display: flex;
    flex-direction: column;
    min-height: 100%;
  }

  /* Colonne « affiche » : fond jaune-orangé des affiches Résultats, encre noire. */
  .contact__affiche {
    padding: 22px 64px 22px 18px;
    background: var(--degrade-histoire);
    color: var(--encre-histoire);
  }
  .contact__titre {
    margin: 0;
    font-family: var(--f-affiche);
    font-weight: 400;
    font-size: clamp(44px, 11vw, 76px);
    line-height: 0.88;
    text-transform: uppercase;
  }
  .contact__accroche {
    margin: 10px 0 0;
    color: var(--encre-histoire);
    font-size: 19px;
  }

  /* Salle, mail, inscription : discrets après le bouton « Envoyer » sur mobile. */
  .contact__coordonnees {
    margin: 0 18px;
    padding: 18px 0 28px;
    border-top: 1px solid var(--bordure-forte);
    color: var(--texte-discret);
    font-size: 15px;
    line-height: 1.4;
  }
  .contact__infos {
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .contact__infos li {
    display: flex;
    gap: 10px;
  }
  .contact__infos li + li {
    margin-top: 10px;
  }
  .contact__infos :global(svg) {
    flex-shrink: 0;
    margin-top: 1px;
  }
  .contact__adhesion {
    margin: 14px 0 0;
  }
  .contact__coordonnees a {
    color: inherit;
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .contact__zone {
    flex: 1 1 auto;
    min-width: 0;
    padding: 22px 18px 24px;
  }
  .contact__fermer {
    position: absolute;
    top: 14px;
    right: 14px;
    border-color: var(--encre-histoire);
    color: var(--encre-histoire);
  }

  /* Grand écran : colonne jaune à gauche (affiche en haut, coordonnées en bas), formulaire à droite. */
  @media (min-width: 900px) {
    .contact__corps {
      display: grid;
      grid-template-columns: 360px minmax(0, 1fr);
      grid-template-rows: 1fr auto;
      grid-template-areas:
        "affiche zone"
        "coordonnees zone";
    }
    .contact__affiche {
      grid-area: affiche;
      padding: 44px 36px 0;
    }
    .contact__accroche {
      margin-top: 16px;
      font-size: 22px;
    }
    .contact__coordonnees {
      grid-area: coordonnees;
      margin: 0;
      padding: 28px 36px 44px;
      border: 0;
      background: var(--degrade-histoire);
      color: var(--encre-histoire);
      font-weight: 600;
      font-size: 16px;
    }
    .contact__coordonnees a {
      text-decoration-thickness: 2px;
    }
    .contact__adhesion {
      margin-top: 22px;
      padding-top: 18px;
      border-top: 2px solid var(--encre-histoire);
      font-weight: 400;
      font-size: 15px;
    }
    .contact__zone {
      grid-area: zone;
      padding: 44px 44px 40px;
    }
    .contact__fermer {
      top: 16px;
      right: 16px;
      border-color: var(--texte);
      color: var(--texte);
    }
  }
</style>
